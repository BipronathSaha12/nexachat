# ============================================================
# TEMPLATE — copy to .env and fill in. SAFE TO COMMIT.
# ============================================================

# ---------- Django core ----------
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-generate-with-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=DEBUG

# ---------- Google Gemini ----------
# PASTE YOUR KEY FROM https://aistudio.google.com/apikey ON THE LINE BELOW
GEMINI_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.1-pro
GEMINI_FALLBACK_MODEL=gemini-3.6-flash-lite
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TEMPERATURE=0.7
# Gemini 3.x reasoning control: "low" (cheap/fast) or "high". Empty = model default.
# NOTE: the older GEMINI_THINKING_BUDGET is rejected with HTTP 400 by Gemini 3.x models.
GEMINI_THINKING_LEVEL=low

# ---------- Conversation context ----------
CONTEXT_MAX_TOKENS=32000
CONTEXT_MAX_MESSAGES=40

# ---------- Database ----------
DATABASE_URL=postgres://chatbot:chatbot@localhost:5432/chatbot
DB_CONN_MAX_AGE=60

# ---------- Redis (rate limiting, cache, celery) ----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- Auth / JWT ----------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# ---------- CORS / CSRF ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# ---------- Rate limiting ----------
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_DAY=500
RATE_LIMIT_ANON_PER_MINUTE=5
RATE_LIMIT_AUTH_PER_MINUTE=10

# ---------- Streaming ----------
STREAM_TRANSPORT=sse
STREAM_HEARTBEAT_SECONDS=15
STREAM_IDLE_TIMEOUT_SECONDS=120

# ---------- Email ----------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ---------- Observability ----------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ENVIRONMENT=local

# ---------- Frontend ----------
FRONTEND_URL=http://localhost:5173
